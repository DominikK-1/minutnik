<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="380"
        Width="460" Height="380"
        CanResize="false"
        WindowStartupLocation="CenterScreen"
        x:Class="minutnik.MainWindow"
        Title="Minutnik">

    <Grid Margin="24" RowDefinitions="Auto,*,Auto">
        <!-- Settings Section -->
        <Border Grid.Row="0"
                Background="#F7F9FC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12">
            <Grid ColumnDefinitions="*,16,*">
                <!-- Work Duration -->
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Czas pracy (min):"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#334155" />
                    <NumericUpDown x:Name="WorkDurationNumericUpDown"
                                   Value="25"
                                   Minimum="1"
                                   Maximum="180"
                                   Increment="1"
                                   FormatString="0"
                                   ValueChanged="WorkDurationNumericUpDown_ValueChanged" />
                </StackPanel>

                <!-- Break Duration -->
                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Text="Czas przerwy (min):"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#334155" />
                    <NumericUpDown x:Name="BreakDurationNumericUpDown"
                                   Value="5"
                                   Minimum="1"
                                   Maximum="60"
                                   Increment="1"
                                   FormatString="0"
                                   ValueChanged="BreakDurationNumericUpDown_ValueChanged" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Display (Timer and Cycle Counter side-by-side) -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,16"
                Padding="16,12">
            <Grid ColumnDefinitions="*,1,*" VerticalAlignment="Center">
                <!-- Timer Display with Current Mode -->
                <StackPanel Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="4">
                    <TextBlock x:Name="ModeTextBlock"
                               Text="Praca"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="#0284C7" />
                    <TextBlock x:Name="TimerTextBlock"
                               Text="25:00"
                               FontSize="48"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               FontFamily="Consolas, Cascadia Code, Courier New"
                               Foreground="#0F172A" />
                </StackPanel>

                <!-- Divider -->
                <Rectangle Grid.Column="1"
                           Fill="#E2E8F0"
                           Width="1"
                           Height="70"
                           VerticalAlignment="Center" />

                <!-- Completed Cycles Counter -->
                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="4">
                    <TextBlock Text="Skończone cykle"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="#64748B" />
                    <TextBlock x:Name="CycleCountTextBlock"
                               Text="0"
                               FontSize="48"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="#16A34A" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Controls Section (Start/Pauza and Reset) -->
        <Grid Grid.Row="2" ColumnDefinitions="*,16,*">
            <Button x:Name="StartPauseButton"
                    Grid.Column="0"
                    Content="Start"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Height="42"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Click="StartPauseButton_Click" />
            <Button x:Name="ResetButton"
                    Grid.Column="2"
                    Content="Reset"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Height="42"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Click="ResetButton_Click" />
        </Grid>
    </Grid>
</Window>
